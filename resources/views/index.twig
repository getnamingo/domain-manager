<!doctype html>
<html lang="{{ _lang ?: 'en' }}" dir="{{ _lang in ['ar', 'ar_SA'] ? 'rtl' : 'ltr' }}"{% if screen_mode == 'dark' %} data-bs-theme="dark"{% endif %}{% if theme is not defined or theme is empty %} data-bs-theme-primary="purple"{% else %} data-bs-theme-primary="{{ theme }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Namingo Domain Manager - a powerful multi-provider DNS management tool that allows users to manage DNS zones.">
    <meta name="author" content="Namingo Team">
    <meta name="keywords" content="Namingo, DNS Panel, Domain Management, Registrar Tools, Namingo Software, ICANN, Domain Registrar">
    <meta name="theme-color" content="#A62A6C">
    <title>Home | Domain Manager</title>
    {% include 'partials/css.twig' %}
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg h-100 border-bottom shadow-sm">
            <div class="container-xl">
                <a class="navbar-brand" href="."><img src="{{ logoPath }}" style="height: 35px; width: auto;" /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar" aria-controls="navbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbar">
                    <ul class="navbar-nav ms-lg-auto text-center text-lg-start">
                        <li class="nav-item">
                            <a {{ is_current_url('index') ? 'class="nav-link active" aria-current="page"' : 'class="nav-link"' }} href="{{route('index')}}">
                                Home
                            </a>
                        </li>

                        <li class="nav-item d-none d-lg-block">
                            <span class="nav-link disabled px-2">|</span>
                        </li>

                        {% if auth.isLogin %}
                            <li class="nav-item">
                                <a {{ is_current_url('home') ? 'class="btn btn-primary me-2"' : 'class="btn btn-primary me-2"' }} href="{{route('home')}}">
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a {{ is_current_url('logout') ? 'class="btn btn-outline-primary"' : 'class="btn btn-outline-primary"' }} href="{{route('logout')}}">
                                    Logout
                                </a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a {{ is_current_url('login') ? 'class="btn btn-outline-primary me-2"' : 'class="btn btn-outline-primary me-2"' }} href="{{route('login')}}">
                                    Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a {{ is_current_url('register') ? 'class="btn btn-primary"' : 'class="btn btn-primary"' }} href="{{route('register')}}">
                                    Register
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        <div class="container-fluid p-5 rounded-3 text-center">
            <div class="text-center my-5">
                <h1 class="fw-bold">DNS Panel</h1>
            </div>

            <div class="row row-cols-1 row-cols-md-2 g-4 mt-6">
                <div class="col">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">Open Panel</h5>
                            <p class="card-text">
                                {% if auth.isLogin %}
                                Access your DNS dashboard and manage zones.
                                {% else %}
                                Log in to access your DNS dashboard and manage zones.
                                {% endif %}
                            </p>
                            {% if auth.isLogin %}
                            <a href="{{route('home')}}" class="btn btn-primary">Dashboard</a>
                            {% else %}
                            <a href="{{route('login')}}" class="btn btn-primary">Log in</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card">
                        <div class="card-body text-center">
                            <h5 class="card-title">DNS Tools</h5>
                            <p class="card-text">Quickly access DNS records and analysis tools.</p>
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <a href="https://dnsrecords.io/" target="_blank" class="btn btn-secondary">dnsrecords.io</a>
                                <a href="https://digwebinterface.com/" target="_blank" class="btn btn-secondary">Web DIG</a>
                                <a href="https://tools.keycdn.com/dig" target="_blank" class="btn btn-secondary">DNS Checker</a>
                                <a href="https://mxtoolbox.com/" target="_blank" class="btn btn-secondary">MX Lookup</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info alert-dismissible mt-4" role="alert">
                <div class="alert-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" 
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon">
                    <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 9h.01" /><path d="M11 12h1v4h1" />
                    </svg>
                </div>
                <h4 class="alert-title">To edit this page, open <code>resources/views/index.twig</code> and replace the content.</h4>
                <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
            </div>
        </div>
    </main>

    <footer class="footer border-top shadow-sm py-3">
        <div class="container-xl">
            <span class="text-muted">&copy; {{ 'now' | date('Y') }} <strong>{{ app_name }}</strong>. All rights reserved.</span>
        </div>
    </footer>
    {% include 'partials/js.twig' %}
</body>
</html>